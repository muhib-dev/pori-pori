# Copy to .env.local and adjust.

# Address a phone should open (used for the desktop QR code). Set it to the public URL,
# or your LAN address in dev (e.g. http://192.168.1.20:3000/). Falls back to the current origin.
NEXT_PUBLIC_SITE_URL=

# Optional sync backend. pushPending() POSTs to ${NEXT_PUBLIC_SYNC_URL}/sync; unset = no sync.
NEXT_PUBLIC_SYNC_URL=
